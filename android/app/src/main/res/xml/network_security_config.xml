<?xml version="1.0" encoding="utf-8"?>
<!-- Home dashboards are commonly served over plain HTTP on the local network
     (Home Assistant's default), so cleartext stays allowed. Prefer HTTPS
     wherever the dashboard supports it. User-installed CAs are not trusted. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
